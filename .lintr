linters: linters_with_defaults(
    assignment_linter = assignment_linter(operator = "="),
    line_length_linter = line_length_linter(120),
    object_name_linter = object_name_linter(styles = c("snake_case", "symbols"), regexes = c(tkoi_class = "^tKOIList$")),
    object_usage_linter = NULL,
    pipe_consistency_linter = pipe_consistency_linter(pipe = "|>"),
    return_linter = NULL,
    object_length_linter = object_length_linter(40),
    indentation_linter = NULL
  )
exclusions: list(
    "R/RcppExports.R",
    "tests/testthat/helper-legacy.R"
  )
encoding: "UTF-8"
